# Copie para .env e preencha. O .env nunca vai para o git.
OPENROUTER_API_KEY=
MEM0_API_KEY=
TAVILY_API_KEY=
TELEM_API_KEY=

# Desliga a telemetria do SDK do Mem0 (ele enviaria o e-mail da conta ao PostHog)
MEM0_TELEMETRY=false

# Modelos no OpenRouter
PLANNER_MODEL=anthropic/claude-haiku-5.5
ANSWER_MODEL=anthropic/claude-haiku-5.5

# Usuário fictício da demo no Mem0
DEMO_USER_ID=search-hack

# Servidor da Telem do hackathon (as chaves do hack.telem.ai só valem aqui)
TELEM_BASE_URL=https://hack.telem.ai/api/router

# FinOps: buscadores entre os quais a Telem pode escolher
TELEM_PROVIDERS=exa,tavily,brave
